#!/usr/bin/env bash
# apply-telemetryd — deliver the desktop telemetry ingress on k12-personal.
#
# telemetryd is deployed on exactly one machine, so Terminus-OS owns it whole:
# source, unit, and this leg. Every other machine is a loud no-op.
#
# The daemon executes from an installed generation, never from the checkout:
# terminus-install-generation builds and validates the candidate beside the
# running tree and only then makes it current, so a refusal anywhere in this
# leg leaves the serving generation exactly as it was.
set -euo pipefail

machine="${1:?usage: apply-telemetryd <machine>}"
if [[ "$machine" != "k12-personal" ]]; then
  echo "apply($machine): telemetryd leg NO-OP — telemetryd runs only on k12-personal"
  exit 0
fi

fleet="${FLEET_CHECKOUT:-$HOME/runtimes/Token-Fleet/live}"
"$fleet/shared/bin/validate-service-placement" telemetryd "$machine"
terminus="${TERMINUS_CHECKOUT:-$HOME/runtimes/Terminus-OS/live}"
unit_src="$terminus/packages/telemetryd/systemd/telemetryd.service"
source_dir="$terminus/packages/telemetryd/src"
if [[ ! -f "$unit_src" ]] || [[ ! -d "$source_dir" ]]; then
  echo "apply($machine): telemetryd leg PARKED — Terminus telemetryd package is not present"
  exit 0
fi

grep -qx 'WorkingDirectory=%h/.local/lib/terminus-os/telemetryd/packages/telemetryd' "$unit_src" || {
  echo "apply($machine): telemetryd WorkingDirectory is not the installed generation this leg realizes" >&2
  exit 1
}
grep -qx 'ExecStart=%h/.bun/bin/bun src/daemon.ts' "$unit_src" || {
  echo "apply($machine): telemetryd must use the Fleet-pinned Bun" >&2
  exit 1
}
grep -qx 'Environment=TELEMETRYD_BIND=127.0.0.1' "$unit_src" || {
  echo "apply($machine): telemetryd must remain loopback-only behind edge-proxy" >&2
  exit 1
}
grep -qx 'Restart=on-failure' "$unit_src" || {
  echo "apply($machine): telemetryd must fail loud and restart on failure" >&2
  exit 1
}

unit_dir="$HOME/.config/systemd/user"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/token-fleet"
unit_dst="$unit_dir/telemetryd.service"
generation_dropin="$unit_dir/telemetryd.service.d/generation.conf"
stamp="$state_dir/telemetryd.applied.sha256"
sha="$(git -C "$terminus" rev-parse HEAD)"

# The generation digest is the restart key: it moves exactly when the tree the
# daemon would load changed, and an unrelated Terminus-OS merge leaves it — and
# the daemon — alone. The checkout SHA reaches the daemon as its build stamp
# through a drop-in the digest does not fold, so /health names the checkout a
# running generation was realized from without every merge forcing a restart.
generation="$("$terminus/bin/terminus-install-generation" "$terminus" telemetryd src/daemon.ts)"
new_hash="$({ cat "$unit_src"; printf 'generation=%s\n' "$generation"; } | sha256sum | cut -d' ' -f1)"
old_hash="$(cat "$stamp" 2>/dev/null || true)"

mkdir -p "$unit_dir" "$(dirname "$generation_dropin")" "$state_dir"
cp -f "$unit_src" "$unit_dst"
printf '[Service]\nEnvironment=GIT_SHA=%s\n' "$sha" >"$generation_dropin"
systemctl --user daemon-reload
systemctl --user enable telemetryd.service
if [[ "$new_hash" != "$old_hash" ]] || ! systemctl --user is-active --quiet telemetryd.service; then
  systemctl --user restart telemetryd.service
else
  echo "apply($machine): telemetryd unchanged and active — no restart"
fi

# Promotion is the function rung, never the restart returning: the restart
# blocked on the daemon's own readiness edge, so a probe that is not ready here
# is a verdict. The stamp is withheld on refusal, so the generation is never
# recorded as converged and the next converge restarts and re-reads it.
"$fleet/shared/bin/prove-service-function-ready" telemetryd "$machine" || {
  echo "apply($machine): telemetryd generation ${generation:0:12} did NOT promote; stamp withheld" >&2
  exit 1
}
echo "$new_hash" > "$stamp"
echo "apply($machine): telemetryd converged (generation ${generation:0:12}, terminus sha ${sha:0:9})"
