#!/usr/bin/env bash
# Retire installed services whose owning Terminus package no longer exists.
# A package deletion is an instruction to remove its runtime artifacts, not to
# leave its last installed generation running forever.
set -euo pipefail

machine="${1:?usage: retire-orphan-packages <machine>}"
if [[ "$machine" != "k12-personal" ]]; then
  echo "retire-orphan-packages($machine): no Terminus services on this machine"
  exit 0
fi

service_user=tokenamby
service_uid=1000
service_home=/home/tokenamby
terminus="${TERMINUS_CHECKOUT:-$service_home/runtimes/Terminus-OS/live}"
unit_dir="${TERMINUS_UNIT_DIR:-$service_home/.config/systemd/user}"
config_dir="${TERMINUS_CONFIG_DIR:-$service_home/.config/token-fleet}"
state_dir="${TERMINUS_STATE_DIR:-$service_home/.local/state/token-fleet}"
install_root="${TERMINUS_INSTALL_ROOT:-$service_home/.local/lib/terminus-os}"
runuser="${RUNUSER:-/usr/sbin/runuser}"
systemctl="${SYSTEMCTL:-/usr/bin/systemctl}"
retired=0

user_systemctl() {
  "$runuser" --user "$service_user" -- /usr/bin/env \
    "HOME=$service_home" \
    "USER=$service_user" \
    "LOGNAME=$service_user" \
    "XDG_RUNTIME_DIR=/run/user/$service_uid" \
    "$systemctl" --user "$@"
}

shopt -s nullglob
for dropin in "$unit_dir"/*.service.d/generation.conf; do
  working_directory="$(sed -n 's/^WorkingDirectory=//p' "$dropin")"
  if [[ "$working_directory" == "$terminus/packages/"* ]]; then
    package="${working_directory#"$terminus/packages/"}"
  elif [[ "$working_directory" == "$install_root/"*/packages/* ]]; then
    package="${working_directory##*/packages/}"
  else
    continue
  fi
  [[ "$package" != */* && -n "$package" ]] || continue
  [[ ! -f "$terminus/packages/$package/package.json" ]] || continue

  service_dir="$(dirname "$dropin")"
  service="$(basename "$service_dir" .service.d)"
  related=("$unit_dir/$service.service" "$unit_dir/$package-"*.path)
  unit_names=()
  for unit in "${related[@]}"; do
    [[ -e "$unit" ]] || continue
    unit_names+=("$(basename "$unit")")
  done
  if ((${#unit_names[@]})); then
    user_systemctl disable --now "${unit_names[@]}"
  fi
  rm -f "${related[@]}" "$config_dir/$package.json" "$state_dir/$package.applied.sha256"
  rm -rf "$service_dir" "$install_root/$package" "$install_root/generations/$package"
  rm -rf "$working_directory"
  retired=$((retired + 1))
  echo "retire-orphan-packages($machine): retired $package"
done

# Workspace libraries have no unit drop-in to lead the service loop above.
# A package directory with no manifest is residue from a package deleted at
# the synchronized candidate, so remove that exact immediate child too.
for package_dir in "$terminus"/packages/*; do
  [[ -d "$package_dir" && ! -f "$package_dir/package.json" ]] || continue
  package="$(basename "$package_dir")"
  [[ "$package" != */* && -n "$package" ]] || continue
  rm -rf "$package_dir"
  retired=$((retired + 1))
  echo "retire-orphan-packages($machine): retired $package"
done

if ((retired)); then
  user_systemctl daemon-reload
else
  echo "retire-orphan-packages($machine): no orphan packages"
fi
