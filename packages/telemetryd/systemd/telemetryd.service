[Unit]
Description=Terminus desktop telemetry ingress
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
Environment=TELEMETRYD_BIND=127.0.0.1
Environment=TELEMETRYD_PORT=7784
Environment=TOKEN_FLEET_MACHINE_CONFIG_ROOT=%h/runtimes/Token-Fleet/live/machines
ExecStart=%h/.bun/bin/bun src/daemon.ts
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
