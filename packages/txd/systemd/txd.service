# txd — Terminus-OS estate daemon (event-sourced tmux control plane).
#
# User-scoped unit (ruled 2026-07-20: user-tier is the fleet-wide pattern —
# root-free CD, tmux is user-scoped so the estate daemon lives in the user
# session's native habitat). Installed by the Token-Fleet apply leg to
# ~/.config/systemd/user/; lingering is enabled on the boxes.
#
# No PrivateTmp — documented pin ([[txd-extraction-spec]] §3.3): the daemon's
# tmux children and test fixtures share the real /tmp namespace deliberately.

[Unit]
Description=Terminus-OS txd event-sourced estate daemon (tmux control plane)
BindsTo=tx-estate.service
After=network-online.target tx-estate.service
Wants=network-online.target
# Missing config must NOT crashloop every RestartSec: skip the unit cleanly
# with a visible condition-failed status until ~/secrets/txd/txd.json is
# seeded (see README "Config bootstrap"). Path matches TXD_CONFIG below.
ConditionPathExists=%h/secrets/txd/txd.json
# Machine identity is a boot prerequisite, not a daemon crash surprise. An
# assertion fails activation loudly when the generated registry is absent;
# ExecStartPre also proves the service user can read it before Bun starts.
AssertPathExists=%h/runtimes/Token-Fleet/live/shared/generated/registry.json
# A deterministic startup failure must fail loud ONCE, not every RestartSec
# forever. systemd's default limit (5 starts / 10s) never trips here: RestartSec=2
# plus a ~0.3s crash is a ~2.3s cycle, i.e. ~4.3 starts per 10s — which is how a
# single non-canonical Council held the whole control plane down for 15 minutes
# across 8832 silent restarts (2026-07-26/27). Ordering already covers the only
# legitimate transient: After=/BindsTo= gate txd on tx-estate.service, and that
# unit's activation Wants=txd.service starts txd once the server is back. A
# repeated identical failure is deterministic and retrying it is pure noise.
# The window is sized to
# contain the burst it must catch — 5 starts x ~2.3s ~= 12s, well inside 60s —
# so the loop provably trips and the unit lands in failed, where it is visible.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# The daemon writes sd_notify READY=1 once the control plane is serving, and
# that write is what completes the start job — so a caller's `systemctl restart
# txd.service` returns on the serving edge instead of at fork. The estate rung
# runs after the signal on purpose: txd must stay reachable while an estate is
# unresolved, because /health is the surface that says so.
Type=notify
NotifyAccess=main
# The daemon executes from the installed generation apply-txd realizes with
# terminus-install-generation, never from the deploy checkout: the checkout is a
# synchronization target whose dependency install first destroys every
# node_modules under it. GIT_SHA arrives through the leg's generation drop-in.
WorkingDirectory=%h/.local/lib/terminus-os/txd/packages/txd
Environment=TXD_CONFIG=%h/secrets/txd/txd.json
Environment=IMPERIUM_MACHINE=k12-personal
Environment=TXD_ROTATION_LOCK_FILE=%h/.local/state/txd/estate-rotation.lock
Environment=TXD_ROTATION_SIGNAL_FIFO=%h/.local/state/txd/estate-rotation.signal
Environment=TXD_AGENT_WRAPPER=%h/runtimes/Token-Fleet/live/shared/bin/agent-wrapper
Environment=TXD_MACHINE_REGISTRY=%h/runtimes/Token-Fleet/live/shared/generated/registry.json
ExecStartPre=/usr/bin/test -r %h/runtimes/Token-Fleet/live/shared/generated/registry.json
# Absolute bun path (pinned 1.3.14 on the fleet).
ExecStart=%h/.bun/bin/bun src/daemon.ts
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
# Never start tmux here. NoNewPrivileges is inherited across fork/exec and
# would propagate from txd to the tmux server and every estate pane. The
# lifecycle-bound tx-estate.service owns the server outside this sandbox.
# Terminate only the bun main process on stop/restart — NOT the whole cgroup.
# The persistent tmux server lives in tx-estate.service; txd spawns only
# short-lived tmux clients. Process-scope teardown leaves those completed
# clients and the separately owned estate alone across daemon restarts.
KillMode=process

[Install]
WantedBy=default.target
